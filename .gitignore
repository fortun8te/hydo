node_modules
dist
.DS_Store

# Agent scratch: run logs and verification output, not source.
.ocodex
.verify

# Local overrides
.env
.env.local
*.log

# Generated icon rasters. The SVG in src/kit/images is the source; run
# `npm run icon` to rebuild these. Keeping a 1.6MB png in git for something
# reproducible from one command is how repos get heavy.
build/icon*.png

# Agent scratch benchmarks. Throwaway by nature.
_bench*.mjs
_cr.mjs

# electron-builder output
dist/mac-arm64/

# Written by scripts/stamp-build.cjs on every build. It describes the machine
# and the moment, not the source — committing it would make every build a diff.
electron/build-stamp.json

# Screenshots agents leave behind. Untracked junk here made every build
# stamp itself dirty:true, which is a lie about the SOURCE.
.claude/*.png
